  "paths": {
    "/torrents/{hash}": {
      "get": {
        "tags": [
          "torrents"
        ],
        "summary": "Get Torrent",
        "operationId": "get_torrent_torrents__hash__get",
        "parameters": [
          {
            "name": "hash",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Hash"
            }
          },
          {
            "name": "trackers",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                {
                  "type": "null"
                }
              ],
              "description": "Custom tracker URLs",
              "title": "Trackers"
            },
            "description": "Custom tracker URLs"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TorrentDetailResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
